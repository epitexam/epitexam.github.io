---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import fallBackImage from "../assets/pexels-pixabay-270488.webp";

interface Props {
    project: CollectionEntry<"projects">;
    index: number;
    headingLevel?: "h2" | "h3";
}

const { project, index, headingLevel = "h3" } = Astro.props;
const { data, id } = project;
const isEager = index < 2;

const imageSrc = data.heroImage ?? fallBackImage;
const imageAlt = data.heroImageDescription || data.title;
const HeadingTag = headingLevel;

const IMG_W = 800;
const IMG_H = 450;
---

<article class="project-card card">
    <div class="card-media">
        <Image
            src={imageSrc}
            alt={imageAlt}
            width={IMG_W}
            widths={[400, 800]}
            sizes="(max-width: 540px) 100vw, (max-width: 1024px) 50vw, 400px"
            height={IMG_H}
            loading={isEager ? "eager" : "lazy"}
            fetchpriority={isEager ? "high" : "auto"}
            decoding="async"
            class="card-image"
        />
        {data.featured && <span class="badge-featured">Featured</span>}
    </div>

    <div class="card-body">
        <HeadingTag class="card-title">
            <a
                href={`/project/${id.replace(/\.mdx?$/, "")}/`}
                class="card-main-link"
            >
                {data.title}
            </a>
        </HeadingTag>

        <p class="card-description">{data.description}</p>

        {
            data.technologies.length > 0 && (
                <ul class="tech-stack">
                    {data.technologies.slice(0, 4).map((tech) => (
                        <li class="tech-stack-item">{tech}</li>
                    ))}
                </ul>
            )
        }

        <div class="card-footer">
            <span class="btn btn-primary" aria-hidden="true">Détails</span>
            {
                (data.liveUrl || data.sourceUrl) && (
                    <div class="card-links">
                        {data.liveUrl && (
                            <a
                                href={data.liveUrl}
                                class="btn btn-secondary"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`Voir la démo du projet : ${data.title} (nouvel onglet)`}
                            >
                                Live
                            </a>
                        )}
                        {data.sourceUrl && (
                            <a
                                href={data.sourceUrl}
                                class="btn btn-secondary"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`Voir le code source du projet : ${data.title} (nouvel onglet)`}
                            >
                                Code
                            </a>
                        )}
                    </div>
                )
            }
        </div>
    </div>
</article>

<style>
    .project-card {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        color: inherit;
        height: 100%;
        cursor: pointer;
        transition:
            transform var(--duration-base) var(--ease-spring),
            box-shadow var(--duration-base) var(--ease-spring),
            border-color var(--duration-base) ease;
    }

    .project-card:focus-within {
        border-color: rgba(var(--accent), 0.4);
        box-shadow: var(--shadow-strong);
    }

    .project-card::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: radial-gradient(
            ellipse at 50% 0%,
            rgba(var(--accent), 0.08) 0%,
            transparent 60%
        );
        opacity: 0;
        z-index: 0;
        pointer-events: none;
        transition: opacity var(--duration-base) ease;
    }

    @media (hover: hover) {
        .project-card:hover::before {
            opacity: 1;
        }
    }

    .card-main-link {
        color: inherit;
        text-decoration: none;
    }

    .card-main-link::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .card-main-link:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
        border-radius: 2px;
    }

    @media (hover: hover) {
        .project-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-strong);
            border-color: rgba(var(--accent), 0.2);
        }
    }

    .card-media {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--tint-05);
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.92) contrast(1.05) saturate(0.95);
        transition:
            transform var(--duration-slow) var(--ease-spring),
            filter var(--duration-slow) ease;
    }

    :root[data-theme="light"] .card-image {
        filter: brightness(1) contrast(1) saturate(1);
    }

    @media (prefers-color-scheme: light) {
        :root:not([data-theme]) .card-image {
            filter: brightness(1) contrast(1) saturate(1);
        }
    }

    @media (hover: hover) {
        .project-card:hover .card-image {
            transform: scale(1.05);
            filter: brightness(1) contrast(1.1) saturate(1.05);
        }
    }

    .badge-featured {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: var(--color-accent);
        color: var(--color-bg);
        font-family: var(--font-title);
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.3rem 0.65rem;
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--tint-20);
        z-index: 2;
    }

    .card-body {
        z-index: 1;
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 1.5rem;
        gap: 1rem;
    }

    .card-title {
        margin: 0;
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        line-height: 1.3;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--color-text);
        transition: color var(--duration-fast) ease;
    }

    @media (hover: hover) {
        .project-card:hover .card-title {
            color: var(--color-accent);
        }
    }

    .card-description {
        font-size: 0.9rem;
        line-height: 1.65;
        color: var(--color-muted);
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tech-stack {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem 0.75rem;
        font-family: var(--font-code);
        font-size: 0.75rem;
        line-height: 1.4;
        color: var(--color-muted);
    }

    .tech-stack-item {
        display: inline-flex;
        align-items: center;
        position: relative;
        margin: 0 !important;
        padding: 0;
        line-height: 1.4;
        transition: color var(--duration-fast) ease;
    }

    .tech-stack-item:not(:last-child)::after {
        content: "";
        display: block;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--tint-20);
        margin-left: 0.75rem;
        flex-shrink: 0;
        align-self: center;
    }

    @media (hover: hover) {
        .tech-stack-item:hover {
            color: var(--color-accent);
        }
        .tech-stack-item:hover::after {
            background: rgba(var(--accent), 0.6);
        }
    }

    .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid var(--color-border);
    }

    .btn-primary,
    .btn-secondary {
        justify-content: center;
        font-size: 0.85rem;
        padding: 0.65rem 1.2rem;
        border-radius: var(--radius-sm);
        transition:
            background var(--duration-fast) ease,
            color var(--duration-fast) ease,
            border-color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
    }

    .btn-primary {
        background: var(--color-accent);
        color: var(--color-bg);
        border: 1px solid transparent;
    }

    @media (hover: hover) {
        .project-card:hover .btn-primary {
            background: rgba(var(--accent), 0.9);
            transform: translateY(-1px);
        }
    }

    .btn-primary:active {
        transform: scale(0.98);
    }

    .card-links {
        display: flex;
        gap: 0.5rem;
        position: relative;
        z-index: 1;
    }

    .btn-secondary {
        background: transparent;
        color: var(--color-text);
        border: 1px solid var(--color-border);
    }

    @media (hover: hover) {
        .btn-secondary:hover {
            color: var(--color-accent);
            border-color: rgba(var(--accent), 0.4);
            background: rgba(var(--accent), 0.05);
        }
    }

    @media (max-width: 480px) {
        .card-body {
            padding: 1.25rem;
        }
        .card-footer {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }
        .btn-primary,
        .btn-secondary {
            width: 100%;
            text-align: center;
        }
        .card-links {
            width: 100%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-card:hover {
            transform: none;
        }
        .project-card:hover .card-image {
            transform: none;
        }
    }
</style>
