---
import FeatureBand from "./FeatureBand.astro";
import WindowMockup from "./WindowMockup.astro";

const features = [
    {
        title: "Frontend moderne",
        desc: "React, Next.js et TypeScript pour des interfaces rapides, accessibles et maintenables.",
    },
    {
        title: "Backend robuste",
        desc: "Node.js, PostgreSQL et API REST/GraphQL conçues pour tenir la charge.",
    },
    {
        title: "DevOps intégré",
        desc: "Docker, CI/CD et infrastructure cloud gérés de bout en bout, sans dépendre d'une équipe externe.",
    },
];
---

<FeatureBand
    badge="Stack &amp; compétences"
    description="Chaque outil de ma stack est choisi pour sa fiabilité et sa pertinence, pas par effet de mode. Voici les briques que j'utilise au quotidien."
    features={features}
    dotted
    reverse
>
    <Fragment slot="title">Une stack choisie avec précision.</Fragment>
    <WindowMockup slot="mock" title="alex.dev — Sélecteur de stack">
        <div class="seg-body">
            <div class="seg-title">Technologies actives</div>
            <div class="chips">
                <span class="node n-purple">• REACT / NEXT.JS</span>
                <span class="node n-blue">• TYPESCRIPT</span>
                <span class="node n-orange">• NODE.JS / EXPRESS</span>
                <span class="node n-teal">• POSTGRESQL</span>
                <span class="node n-red">• DOCKER &amp; CI/CD</span>
            </div>
            <div class="seg-add">
                <span class="seg-input">Ajouter une techno...</span>
                <span class="seg-btn">+ Ajouter</span>
            </div>
            <div class="seg-match">
                <div>
                    <span class="m-label">▪ Projets correspondants</span>
                    <span class="m-sub">Mis à jour à l'instant</span>
                </div>
                <div class="m-right">
                    <b>24</b>
                    <span>projets</span>
                </div>
            </div>
        </div>
    </WindowMockup>
</FeatureBand>