---
import FeatureBand from "./FeatureBand.astro";
import WindowMockup from "./WindowMockup.astro";

const features = [
    {
        title: "Code fiable",
        desc: "Tests automatisés, linting et vérifications continues pour réduire les régressions et garder une base de code saine.",
    },
    {
        title: "Architecture durable",
        desc: "Des applications structurées pour rester lisibles et évolutives, avec une attention particulière portée à la séparation des responsabilités.",
    },
    {
        title: "Performance & production",
        desc: "Optimisation des requêtes, gestion du cache et configuration des environnements pour garantir des applications rapides et stables.",
    },
];
---

<FeatureBand
    badge="Qualité & mise en production"
    description="Construire une application ne s'arrête pas au code : chaque projet est pensé pour être fiable, maintenable et prêt à évoluer."
    features={features}
>
    <Fragment slot="title">Du code à une application fiable.</Fragment>
    <WindowMockup slot="mock" title="Qualité & Production">
        <div class="flow">
            <div class="flow-row">
                <span class="node n-purple"> APPLICATION FULLSTACK</span>
                <div class="flow-stats">
                    <div>
                        <span>Architecture</span><b>Structurée</b>
                    </div>
                    <div>
                        <span>Performance</span><b>Optimisée</b>
                    </div>
                    <div>
                        <span>Code</span><b>Testé &amp; maintenable</b>
                    </div>
                </div>
            </div>
            <i class="vline"></i>
            <span class="node n-blue"> TESTS &amp; VÉRIFICATIONS</span>
            <i class="vline"></i>
            <span class="node n-orange"> BUILD &amp; VALIDATION</span>
            <i class="vline"></i>
            <span class="node n-teal"> APPLICATION PRÊTE ?</span>
            <div class="branch">
                <div class="branch-col">
                    <span class="branch-label">Oui</span>
                    <i class="vline"></i>
                    <span class="node n-green"> MISE EN PRODUCTION</span>
                </div>
                <div class="branch-col">
                    <span class="branch-label">Non</span>
                    <i class="vline"></i>
                    <span class="node n-red"> CORRECTION &amp; ITÉRATION</span>
                </div>
            </div>
        </div>
    </WindowMockup>
</FeatureBand>
