---
import FeatureBand from "./FeatureBand.astro";
import WindowMockup from "./WindowMockup.astro";

const features = [
    {
        title: "Tests automatisés",
        desc: "Suite de tests unitaires et d'intégration exécutée à chaque push pour éviter les régressions.",
    },
    {
        title: "Déploiements multi-environnements",
        desc: "Preview, staging et production, avec rollback instantané en cas de problème.",
    },
    {
        title: "Monitoring en temps réel",
        desc: "Alertes automatiques et logs centralisés pour détecter les anomalies avant les utilisateurs.",
    },
];
---

<FeatureBand
    badge="Intégration continue"
    description="Chaque projet est livré avec un pipeline CI/CD automatisé : tests, build et déploiement s'enchaînent sans intervention manuelle, du commit à la production."
    features={features}
>
    <Fragment slot="title">Un pipeline pensé pour la fiabilité.</Fragment>
    <WindowMockup slot="mock" title="alex.dev — Pipeline CI/CD">
        <div class="flow">
            <div class="flow-row">
                <span class="node n-purple">• PUSH SUR MAIN</span>
                <div class="flow-stats">
                    <div>
                        <span>Commits ce mois</span><b>86</b>
                    </div>
                    <div>
                        <span>Tests réussis</span><b>312 (100%)</b>
                    </div>
                    <div>
                        <span>Durée build</span><b>3m 42s</b>
                    </div>
                </div>
            </div>
            <i class="vline"></i>
            <span class="node n-blue">• LANCEMENT DES TESTS</span>
            <i class="vline"></i>
            <span class="node n-orange">• BUILD &amp; LINT</span>
            <i class="vline"></i>
            <span class="node n-teal">• TOUS LES TESTS PASSENT ?</span>
            <div class="branch">
                <div class="branch-col">
                    <span class="branch-label">Oui</span>
                    <i class="vline"></i>
                    <span class="node n-green">• DÉPLOIEMENT PRODUCTION</span>
                </div>
                <div class="branch-col">
                    <span class="branch-label">Non</span>
                    <i class="vline"></i>
                    <span class="node n-red">• NOTIFICATION ÉQUIPE</span>
                </div>
            </div>
        </div>
    </WindowMockup>
</FeatureBand>