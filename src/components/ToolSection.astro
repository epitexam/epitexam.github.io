---
import ToolCard from "./ToolCard.astro";

const LEVEL_ORDER = { mastered: 0, practiced: 1, exploring: 2 } as const;

export interface Props {
    title: string;
    tools: {
        icon: string;
        name: string;
        description: string;
        level?: "mastered" | "practiced" | "exploring";
        link?: string;
    }[];
}

const { title, tools } = Astro.props;
const sortedTools = [...tools].sort(
    (a, b) =>
        LEVEL_ORDER[a.level ?? "practiced"] -
        LEVEL_ORDER[b.level ?? "practiced"],
);
---

{title && <p class="tool-section-label">{title}</p>}
<ul class="tool-grid" role="list">
    {
        sortedTools.map((tool) => (
            <li class="tool-item">
                <ToolCard {...tool} />
            </li>
        ))
    }
</ul>

<style>
    .tool-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
        width: 100%;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tool-grid > li::before,
    .tool-grid > li::after {
        content: none !important;
        display: none;
    }

    .tool-section-label {
        font-family: var(--font-title);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin: 0;
        padding-left: 0.1rem;
    }

    .tool-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
        width: 100%;
    }

    .tool-item {
        display: flex;
        height: 100%;
    }

    @media (max-width: 640px) {
        .tool-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
