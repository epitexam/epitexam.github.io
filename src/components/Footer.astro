---
import { GITHUB_URL, SITE_TITLE } from "../consts";
import GitHubIcon from "./GitHubIcon.astro";
const today = new Date();
---

<footer class="footer">
    <p class="copyright">
        <span class="copyright-line">
            <span class="copyright-symbol">&copy;</span>
            <span class="copyright-year">{today.getFullYear()}</span>
            <span class="site-name">{SITE_TITLE}</span>
        </span>
        <span class="copyright-sep" aria-hidden="true">—</span>
        <span class="copyright-rights">Tous droits réservés.</span>
    </p>
    <p class="colophon">
        Conçu avec
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        · Hébergé sur
        <a href="https://pages.github.com" target="_blank" rel="noopener noreferrer">GitHub Pages</a>
    </p>
    <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
        aria-label={`Visiter le GitHub de ${SITE_TITLE}`}
    >
        <GitHubIcon size={22} />
    </a>
</footer>

<style>
    .footer {
        width: 100%;
        max-width: var(--max-width);
        margin: auto auto 0;
        padding: 3rem 1.5rem 2.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .footer::before {
        content: "";
        width: 80px;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--tint-20),
            transparent
        );
    }

    /* Desktop : une seule ligne centrée, dont les espaces sont pilotés
       par column-gap (plus de dépendance aux espaces du template). */
    .copyright {
        margin: 0;
        font-family: var(--font-title);
        font-size: 0.85rem;
        letter-spacing: -0.01em;
        color: var(--color-muted);
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        column-gap: 0.35rem;
        row-gap: 0.15rem;
        text-align: center;
    }

    /* « © 2026 Epitexam » reste groupé ; le wrap interne n'intervient
       que sur les très petits écrans. */
    .copyright-line {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        column-gap: 0.35rem;
    }

    .copyright-symbol {
        color: var(--color-accent);
    }

    .copyright-sep {
        opacity: 0.6;
    }

    .site-name {
        color: var(--color-text);
        font-weight: 600;
        transition: color var(--duration-base) ease;
    }

    .footer:hover .site-name {
        color: var(--color-accent);
    }

    .colophon {
        margin: 0;
        font-family: var(--font-code);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        color: var(--color-muted);
    }

    .colophon a {
        color: var(--color-muted);
        text-decoration: none;
        transition: color var(--duration-fast) ease;
    }

    .colophon a:hover {
        color: var(--color-text);
    }

    .social-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-muted);
        transition:
            color var(--duration-base) ease,
            transform var(--duration-base) ease,
            filter var(--duration-base) ease;
    }

    .social-icon:hover {
        color: var(--color-accent);
        transform: translateY(-2px);
        filter: drop-shadow(0 0 8px rgba(var(--accent), 0.2));
    }

    @media (max-width: 640px) {
        .footer {
            padding: 2.5rem 1rem 2rem;
        }

        /* Mobile : deux lignes centrées et équilibrées
           (« © 2026 Epitexam » / « Tous droits réservés. »)
           au lieu d'un fragment par ligne. */
        .copyright {
            flex-direction: column;
            align-items: center;
            row-gap: 0.2rem;
            font-size: 0.8rem;
        }

        .copyright-sep {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .social-icon:hover {
            transform: none;
        }
    }
</style>
