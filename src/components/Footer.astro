---
import { GITHUB_URL, SITE_TITLE } from "../consts";
import GitHubIcon from "./GitHubIcon.astro";
const today = new Date();
---

<footer class="footer">
    <nav class="footer-nav" aria-label="Navigation secondaire">
        <a href="/">Accueil</a>
        <a href="/blog">Blog</a>
        <a href="/project">Projects</a>
        <a href="/contact">Contact</a>
    </nav>
    <p class="status">
        <span class="status-dot" aria-hidden="true"></span>
        Disponible pour missions
    </p>
    <p class="copyright">
        <span class="copyright-symbol">&copy;</span>
        {today.getFullYear()}
        <span class="site-name">{SITE_TITLE}</span>. All rights reserved.
    </p>
    <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
        aria-label={`Visiter le GitHub de ${SITE_TITLE}`}
    >
        <GitHubIcon size={22} />
    </a>
</footer>

<style>
    .footer {
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 3rem 1.5rem 2.5rem;
        background: transparent;
        margin-top: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .footer::before {
        content: "";
        width: 80px;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--tint-20),
            transparent
        );
    }

    .footer-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.25rem 1.5rem;
    }

    .footer-nav a {
        font-family: var(--font-title);
        font-size: 0.82rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--color-muted);
        text-decoration: none;
        padding-block: 0.4rem;
        transition: color var(--duration-fast) ease;
    }

    .footer-nav a:hover {
        color: var(--color-text);
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-family: var(--font-code);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-muted);
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: rgb(var(--badge-green-rgb));
        box-shadow: 0 0 8px rgba(var(--badge-green-rgb), 0.5);
    }

    .copyright {
        margin: 0;
        font-family: var(--font-title);
        font-size: 0.85rem;
        letter-spacing: -0.01em;
        color: var(--color-muted);
    }

    .copyright-symbol {
        color: var(--color-accent);
        margin-right: 0.25rem;
    }

    .site-name {
        color: var(--color-text);
        font-weight: 600;
        transition: color var(--duration-base) ease;
    }

    .footer:hover .site-name {
        color: var(--color-accent);
    }

    .social-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-muted);
        transition:
            color var(--duration-base) ease,
            transform var(--duration-base) ease,
            filter var(--duration-base) ease;
    }

    .social-icon:hover {
        color: var(--color-accent);
        transform: translateY(-2px);
        filter: drop-shadow(0 0 8px rgba(var(--accent), 0.2));
    }

    @media (max-width: 640px) {
        .footer {
            padding: 2.5rem 1rem 2rem;
        }

        .copyright {
            margin: 0;
            font-size: 0.8rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            text-align: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .social-icon:hover {
            transform: none;
        }
    }
</style>
