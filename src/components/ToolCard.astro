---
export interface Props {
  icon: string;
  name: string;
  description: string;
  level?: "mastered" | "practiced" | "exploring";
  link?: string;
}

const { icon, name, description, level = "practiced", link } = Astro.props;

const CardTag = link ? "a" : "div";
const cardProps = link
  ? {
      href: link,
      target: "_blank",
      rel: "noopener noreferrer",
      "aria-label": `En savoir plus sur ${name} (s'ouvre dans un nouvel onglet)`,
    }
  : {};
---

<CardTag class="tool-card card" data-level={level} {...cardProps}>
  <span class="tool-icon" aria-hidden="true">{icon}</span>
  <h3 class="tool-title">{name}</h3>
  <p class="tool-description">{description}</p>
</CardTag>

<style>
  .tool-card {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 1.5rem;
    transition:
      transform var(--duration-base) var(--ease-spring),
      border-color var(--duration-base) var(--ease-spring),
      box-shadow var(--duration-base) var(--ease-spring);
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 0.35rem 1.25rem;
    align-items: start;
    text-align: left;
    color: inherit;
  }

  .tool-card > * {
    position: relative;
    z-index: 1;
  }

  a.tool-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .tool-card:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--accent), 0.2);
    box-shadow: var(--shadow-strong);
  }

  .tool-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      ellipse at 50% 0%,
      rgba(var(--accent), 0.08) 0%,
      transparent 60%
    );
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity var(--duration-base) ease;
  }

  .tool-card:hover::before {
    opacity: 1;
  }

  .tool-icon {
    grid-row: 1 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--tint-05);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    transition:
      border-color var(--duration-base) ease,
      background var(--duration-base) ease;
    overflow: hidden;
    font-size: 1.15rem;
    line-height: 1;
  }

  .tool-card[data-level="mastered"] .tool-icon {
    border-color: rgba(var(--accent), 0.4);
    background: rgba(var(--accent), 0.08);
  }
  .tool-card[data-level="practiced"] .tool-icon {
    border-color: var(--color-border);
    background: var(--tint-05);
  }
  .tool-card[data-level="exploring"] .tool-icon {
    border-color: var(--color-border);
    background: var(--color-surface);
    opacity: 0.7;
  }

  .tool-title {
    grid-column: 2;
    margin: 0;
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color var(--duration-base) ease;
  }

  a.tool-card .tool-title::after {
    content: "↗";
    font-size: 0.9rem;
    opacity: 0;
    transform: translateY(2px) translateX(-4px);
    transition:
      opacity var(--duration-base) var(--ease-spring),
      transform var(--duration-base) var(--ease-spring);
    color: var(--color-accent);
  }

  a.tool-card:hover .tool-title::after {
    opacity: 1;
    transform: translateY(0) translateX(0);
  }

  .tool-card:hover .tool-title {
    color: var(--color-accent);
  }

  .tool-description {
    grid-column: 2;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-muted);
    transition: color var(--duration-base) ease;
  }

  a.tool-card:hover .tool-description {
    color: rgba(var(--text), 0.85);
  }

  .tool-card::after {
    content: "";
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.4;
    z-index: 1;
    pointer-events: none;
  }

  .tool-card[data-level="mastered"]::after {
    opacity: 1;
    box-shadow: 0 0 8px rgba(var(--accent), 0.4);
  }
  .tool-card[data-level="practiced"]::after {
    opacity: 0.6;
  }
  .tool-card[data-level="exploring"]::after {
    background: var(--color-muted);
    opacity: 0.3;
  }

  @media (max-width: 640px) {
    .tool-card {
      padding: 1.25rem;
      grid-template-columns: 2.5rem 1fr;
      gap: 0.35rem 1rem;
    }
    .tool-icon {
      width: 2.5rem;
      height: 2.5rem;
    }
    .tool-title {
      font-size: 1rem;
    }
    .tool-description {
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-card:hover {
      transform: none;
    }
  }
</style>
