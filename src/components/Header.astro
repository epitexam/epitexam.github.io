---
import { GITHUB_URL, SITE_TITLE } from "../consts";
import GitHubIcon from "./GitHubIcon.astro";
import HeaderLink from "./HeaderLink.astro";

const navLinks = [
    { href: "/", label: "Accueil" },
    { href: "/about", label: "À propos" },
    { href: "/tools", label: "Outils" },
    { href: "/blog", label: "Blog" },
    { href: "/project", label: "Projects" },
    { href: "/contact", label: "Contact" },
];
---

<a href="#main-content" class="skip-link">Aller au contenu</a>
<header class="site-header">
    <div class="header-inner">
        <a href="/" class="brand-link">{SITE_TITLE}</a>

        <nav class="desktop-nav" aria-label="Navigation principale">
            {
                navLinks.map(({ href, label }) => (
                    <HeaderLink href={href}>{label}</HeaderLink>
                ))
            }
        </nav>

        <div class="header-right">
            <button
                id="theme-toggle"
                class="theme-toggle"
                aria-label="Basculer en thème clair"
                aria-pressed="false"
                type="button"
            >
                <svg
                    class="icon-sun"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <circle cx="12" cy="12" r="4.25"></circle>
                    <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5"></path>
                </svg>
                <svg
                    class="icon-moon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
                </svg>
            </button>
            <a
                href={GITHUB_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
                aria-label="Voir mon GitHub"
            >
                <GitHubIcon size={16} />
            </a>

            <button
                id="menu-toggle"
                class="menu-toggle"
                aria-label="Ouvrir le menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <span class="menu-bar"></span>
            </button>
        </div>
    </div>

    <nav
        id="mobile-menu"
        class="mobile-menu"
        aria-label="Navigation mobile"
        inert
    >
        <div class="mobile-menu-inner">
            {
                navLinks.map(({ href, label }) => (
                    <HeaderLink href={href} class="mobile-link">
                        {label}
                    </HeaderLink>
                ))
            }
        </div>
    </nav>
</header>

<script>
    (() => {
        const root = document.documentElement;
        const themeToggle = document.getElementById(
            "theme-toggle",
        ) as HTMLButtonElement | null;
        const syncThemeButton = (theme: string) => {
            if (!themeToggle) return;
            const isLight = theme === "light";
            themeToggle.setAttribute("aria-pressed", String(isLight));
            themeToggle.setAttribute(
                "aria-label",
                isLight ? "Basculer en thème sombre" : "Basculer en thème clair",
            );
        };
        const main = document.querySelector("main");
        if (main && !main.getAttribute("id")) {
            main.setAttribute("id", "main-content");
        }
        const currentTheme = () =>
            root.getAttribute("data-theme") === "light" ? "light" : "dark";
        syncThemeButton(currentTheme());
        themeToggle?.addEventListener("click", () => {
            const next = currentTheme() === "light" ? "dark" : "light";
            root.setAttribute("data-theme", next);
            try {
                localStorage.setItem("theme", next);
            } catch {}
            syncThemeButton(next);
            window.dispatchEvent(
                new CustomEvent("theme-change", { detail: next }),
            );
        });
        const toggle = document.getElementById(
            "menu-toggle",
        ) as HTMLButtonElement | null;
        const menu = document.getElementById(
            "mobile-menu",
        ) as HTMLElement | null;
        const header = document.querySelector<HTMLElement>(".site-header");

        if (!toggle || !menu || !header) return;
        if (toggle.hasAttribute("data-menu-initialized")) return;
        toggle.setAttribute("data-menu-initialized", "true");

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const open = () => {
        toggle.setAttribute("aria-expanded", "true");
        toggle.setAttribute("aria-label", "Fermer le menu");
        menu.removeAttribute("inert");
        menu.classList.add("is-open");
        header.classList.add("menu-is-open");
    };

    const close = () => {
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Ouvrir le menu");
        menu.setAttribute("inert", "");
        menu.classList.remove("is-open");
        header.classList.remove("menu-is-open");
    };

    const updateScrollState = () =>
        header.classList.toggle("is-scrolled", window.scrollY > 20);
    let scrollQueued = false;
    const onScroll = () => {
        if (scrollQueued) return;
        scrollQueued = true;
        requestAnimationFrame(() => {
            scrollQueued = false;
            updateScrollState();
        });
    };
    if ("requestAnimationFrame" in window) {
        requestAnimationFrame(updateScrollState);
    } else {
        updateScrollState();
    }
    window.addEventListener("scroll", onScroll, { passive: true });

    const handleToggleClick = (e: MouseEvent) => {
        e.stopPropagation();
        isOpen() ? close() : open();
    };
    const handleLinkClick = () => close();
    const handleOutsideClick = (e: MouseEvent) => {
        const target = e.target as Node;
        if (isOpen() && !menu.contains(target) && !toggle.contains(target))
            close();
    };

    const mediaQuery = window.matchMedia("(min-width: 769px)");
    const handleMediaChange = (e: MediaQueryListEvent) => {
        if (e.matches) close();
    };

    const menuLinks = [...menu.querySelectorAll("a")];

    toggle.addEventListener("click", handleToggleClick);
    menuLinks.forEach((l) => l.addEventListener("click", handleLinkClick));
    document.addEventListener("click", handleOutsideClick);
    if (typeof mediaQuery.addEventListener === "function") {
        mediaQuery.addEventListener("change", handleMediaChange);
    } else {
        (
            mediaQuery as MediaQueryList & {
                addListener?: (fn: (e: MediaQueryListEvent) => void) => void;
            }
        ).addListener?.(handleMediaChange);
        }
    })();
</script>

<style>
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(var(--bg), 0.85);
        border-bottom: 1px solid var(--color-border);
        transition:
            background var(--duration-base) ease,
            border-color var(--duration-base) ease;
    }

    @supports (backdrop-filter: blur(1px)) {
        .site-header {
            background: rgba(var(--bg), 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .site-header.is-scrolled {
            background: rgba(var(--bg), 0.85);
        }
        .site-header.menu-is-open {
            background: rgba(var(--bg), 0.95);
        }
    }

    .site-header.is-scrolled {
        border-bottom-color: var(--tint-14);
    }

    .header-inner {
        height: var(--header-height);
        max-width: var(--max-width);
        margin-inline: auto;
        padding-inline: var(--content-padding);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    @media (max-width: 768px) {
        .header-inner {
            padding-inline: var(--content-padding-mobile);
        }
    }

    .skip-link {
        position: fixed;
        top: 0.5rem;
        left: 50%;
        z-index: 2000;
        padding: 0.65rem 1.1rem;
        background: var(--color-surface-elevated);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-strong);
        color: var(--color-text);
        font-family: var(--font-title);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transform: translate(-50%, -200%);
        transition: transform var(--duration-fast) var(--ease-spring);
    }

    .skip-link:focus-visible {
        transform: translate(-50%, 0);
    }

    .brand-link {
        font-family: var(--font-title);
        font-weight: 600;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        color: var(--color-text);
        white-space: nowrap;
        flex-shrink: 0;
        transition: opacity var(--duration-fast) ease;
    }

    .brand-link:hover {
        opacity: 0.65;
    }

    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 1.75rem;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: var(--radius-sm);
        color: var(--color-muted);
        transition:
            color var(--duration-fast) ease,
            background var(--duration-fast) ease;
    }

    .social-link:hover {
        color: var(--color-text);
        background: var(--tint-05);
    }

    .theme-toggle {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        padding: 0;
        background: none;
        border: none;
        border-radius: var(--radius-sm);
        color: var(--color-muted);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition:
            color var(--duration-fast) ease,
            background var(--duration-fast) ease;
    }

    .theme-toggle:hover {
        color: var(--color-text);
        background: var(--tint-05);
    }

    .theme-toggle svg {
        grid-area: 1 / 1;
        transition:
            opacity var(--duration-fast) ease,
            transform var(--duration-base) var(--ease-spring);
    }

    .theme-toggle .icon-sun {
        opacity: 1;
    }

    .theme-toggle .icon-moon {
        opacity: 0;
        transform: rotate(-45deg) scale(0.85);
    }

    :root[data-theme="light"] .theme-toggle .icon-sun {
        opacity: 0;
        transform: rotate(45deg) scale(0.85);
    }

    :root[data-theme="light"] .theme-toggle .icon-moon {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .theme-toggle svg {
            transition: none;
            transform: none;
        }
    }

    .menu-toggle {
        --bar-w: 18px;
        --bar-h: 2px;
        --bar-gap: 5px;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--bar-gap);
        width: 36px;
        height: 36px;
        padding: 0;
        background: none;
        border: none;
        border-radius: var(--radius-sm);
        color: var(--color-muted);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: color var(--duration-fast) ease;
    }

    .menu-toggle:hover {
        color: var(--color-text);
    }

    .menu-bar {
        position: relative;
        display: block;
        width: var(--bar-w);
        height: var(--bar-h);
        background: currentColor;
        border-radius: 999px;
        transition:
            background var(--duration-fast) ease,
            transform var(--duration-fast) var(--ease-spring),
            opacity var(--duration-fast) ease;
    }

    .menu-bar::before,
    .menu-bar::after {
        content: "";
        position: absolute;
        left: 0;
        width: 100%;
        height: 100%;
        background: currentColor;
        border-radius: inherit;
        transition:
            top var(--duration-fast) var(--ease-spring),
            bottom var(--duration-fast) var(--ease-spring),
            transform var(--duration-fast) var(--ease-spring);
    }

    .menu-bar::before {
        top: calc(-1 * (var(--bar-gap) + var(--bar-h)));
    }

    .menu-bar::after {
        bottom: calc(-1 * (var(--bar-gap) + var(--bar-h)));
    }

    .menu-toggle[aria-expanded="true"] .menu-bar {
        background: transparent;
    }
    .menu-toggle[aria-expanded="true"] .menu-bar::before {
        top: 0;
        transform: rotate(45deg);
    }
    .menu-toggle[aria-expanded="true"] .menu-bar::after {
        bottom: 0;
        transform: rotate(-45deg);
    }

    .mobile-menu {
        background: rgba(var(--bg), 0.95);
        border-top: 1px solid var(--color-border);
    }

    @supports (backdrop-filter: blur(1px)) {
        .mobile-menu {
            background: rgba(var(--bg), 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    }

    .mobile-menu-inner {
        overflow: hidden;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .mobile-menu-inner > :global(a),
    :global(a.mobile-link) {
        display: flex;
        align-items: center;
        padding: 1rem var(--content-padding-mobile);
        min-height: 44px;
        font-family: var(--font-title);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
        border-bottom: 1px solid var(--tint-05);
        transition:
            color var(--duration-fast) ease,
            background var(--duration-fast) ease;
    }

    .mobile-menu-inner > :global(a:hover),
    :global(a.mobile-link:hover) {
        background: var(--tint-05);
        color: var(--color-text);
    }

    .mobile-menu-inner > :global(a:last-child),
    :global(a.mobile-link:last-child) {
        border-bottom: none;
    }
    .mobile-menu-inner > :global(a.active),
    :global(a.mobile-link.active) {
        color: var(--color-accent);
    }

    @keyframes nav-item-in {
        from {
            opacity: 0;
            transform: translateX(-8px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .mobile-menu.is-open :global(a.mobile-link) {
        animation: nav-item-in var(--duration-fast) var(--ease-spring) both;
    }
    .mobile-menu.is-open :global(a.mobile-link:nth-child(1)) {
        animation-delay: 0.05s;
    }
    .mobile-menu.is-open :global(a.mobile-link:nth-child(2)) {
        animation-delay: 0.1s;
    }
    .mobile-menu.is-open :global(a.mobile-link:nth-child(3)) {
        animation-delay: 0.15s;
    }
    .mobile-menu.is-open :global(a.mobile-link:nth-child(4)) {
        animation-delay: 0.2s;
    }
    .mobile-menu.is-open :global(a.mobile-link:nth-child(5)) {
        animation-delay: 0.25s;
    }
    .mobile-menu.is-open :global(a.mobile-link:nth-child(6)) {
        animation-delay: 0.3s;
    }

    @media (max-width: 768px) {
        .desktop-nav {
            display: none;
        }
        .menu-toggle {
            display: flex;
        }
        .mobile-menu {
            display: grid;
            grid-template-rows: 0fr;
            opacity: 0;
            transition:
                grid-template-rows var(--duration-base) var(--ease-spring),
                opacity var(--duration-fast) ease;
        }
        .mobile-menu.is-open {
            grid-template-rows: 1fr;
            opacity: 1;
            box-shadow: var(--shadow-strong);
        }
    }

    @media (min-width: 769px) {
        .mobile-menu {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .site-header,
        .mobile-menu,
        .menu-bar,
        .menu-bar::before,
        .menu-bar::after {
            transition: none;
        }
        .mobile-menu.is-open :global(a.mobile-link) {
            animation: none;
            opacity: 1;
        }
    }
</style>
