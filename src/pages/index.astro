---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import HeroSection from "../components/home/HeroSection.astro";
import AutomationSection from "../components/home/AutomationSection.astro";
import SegmentationSection from "../components/home/SegmentationSection.astro";
import CrmSection from "../components/home/CrmSection.astro";
import AnalyticsSection from "../components/home/AnalyticsSection.astro";
import CtaSection from "../components/home/CtaSection.astro";
import "../styles/home.css";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <div class="am-root">
            <main class="am-main">
                <Header />
                <HeroSection />
                <AutomationSection />
                <SegmentationSection />
                <CrmSection />
                <AnalyticsSection />
                <CtaSection />
                <Footer />
            </main>
        </div>
    </body>
</html>
