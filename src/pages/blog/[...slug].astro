---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter(({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id.replace(/\.mdx?$/, '') },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const isTeaser = post.data.teaser;
---

<BlogPost {...post.data}>
	{isTeaser ? (
		<div class="teaser-content">
			<p class="teaser-notice" role="status">
				<strong>Article en préparation</strong>
				<span>Le contenu complet n’est pas encore disponible. Voici un aperçu de l’article.</span>
			</p>
			<p class="teaser-synopsis">{post.data.description}</p>
		</div>
	) : (
		<Content />
	)}
</BlogPost>


<style>
    .teaser-content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .teaser-notice {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        margin: 0;
        padding: 1.35rem 1.5rem 1.35rem 1.65rem;
        border: 1px solid var(--accent-muted);
        border-radius: var(--radius-md);
        background: linear-gradient(110deg, var(--accent-subtle), var(--tint-05));
        box-shadow: var(--shadow-soft);
        color: var(--color-muted);
        text-align: center;
    }

    .teaser-notice::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 3px;
        border-radius: var(--radius-md) 0 0 var(--radius-md);
        background: var(--color-accent);
        opacity: 0.85;
    }

    .teaser-notice strong {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        color: var(--color-text);
        font-family: var(--font-title);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.01em;
    }

    .teaser-notice > span {
        max-width: 68ch;
        font-size: 0.95rem;
        line-height: 1.65;
        text-align: center;
    }

    .teaser-synopsis {
        margin: 0;
    }
</style>
