---
import ErrorLayout from "../layouts/ErrorLayout.astro";
import { SITE_TITLE } from "../consts";

interface Props {
    error: unknown;
}

const { error } = Astro.props;
const message = error instanceof Error ? error.message : "Erreur inconnue";
---

<ErrorLayout
    headTitle={`Erreur serveur  ${SITE_TITLE}`}
    headDescription="Une erreur est survenue lors du traitement de votre requête."
    label="Erreur 500"
    code="500"
    title="Erreur serveur"
    subtitle="Une erreur inattendue est survenue. Réessayez dans quelques instants."
    detail={message}
/>
