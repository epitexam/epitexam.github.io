---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ProjectPost from "../../layouts/ProjectPost.astro";

export async function getStaticPaths() {
    const projects = (await getCollection("projects")).filter(({ data }) => !data.draft);
    return projects.map((project) => ({
        params: { slug: project.id.replace(/\.mdx?$/, '') },
        props: project,
    }));
}

type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await render(project);

const siblings = (await getCollection("projects"))
    .filter(({ data }) => !data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const position = siblings.findIndex((p) => p.id === project.id);
const toNavTarget = (p: (typeof siblings)[number] | undefined) =>
    p ? { title: p.data.title, slug: p.id.replace(/\.mdx?$/, "") } : undefined;
---

<ProjectPost
    {...project.data}
    prev={toNavTarget(siblings[position - 1])}
    next={toNavTarget(siblings[position + 1])}
>
    <Content />
</ProjectPost>
