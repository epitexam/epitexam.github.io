---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { SITE_TITLE, GITHUB_URL } from "../../consts";

export const getStaticPaths = (async ({ paginate }) => {
    const projects = (await getCollection("projects"))
        .filter((p) => !p.data.draft)
        .filter((p) => !p.data.featured)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(projects, { pageSize: 2 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const others = page.data;

const allProjects = (await getCollection("projects")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const publishedProjects = allProjects.filter((p) => !p.data.draft);
const featured = publishedProjects.filter((p) => p.data.featured);
const isEmpty = publishedProjects.length === 0;

const PROJECT_META_DESCRIPTION = `Réalisations techniques d'Epitexam  projets fullstack, applications web et expérimentations en TypeScript, React, Node.js et Go.`;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `Projets  ${SITE_TITLE}`,
    description: PROJECT_META_DESCRIPTION,
    url: "https://epitexam.github.io/project",
    author: {
        "@type": "Person",
        name: "Epitexam",
        url: "https://epitexam.github.io",
        sameAs: [GITHUB_URL],
    },
    numberOfItems: allProjects.length,
    itemListElement: allProjects.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: p.data.title,
        description: p.data.description,
        url: `https://epitexam.github.io/project/${p.id}/`,
        ...(p.data.liveUrl && { sameAs: p.data.liveUrl }),
    })),
};
---

<!doctype html>
<html lang="fr">
    <head>
        <BaseHead
            title={`Projets  ${SITE_TITLE}`}
            description={PROJECT_META_DESCRIPTION}
        />
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </head>
    <body>
        <Header />

        <main>
            <div class="project-index">
                <header class="page-header animate-fade-in">
                    <div class="header-eyebrow">
                        <span class="dot" aria-hidden="true"></span>
                        <span class="label">Portfolio</span>
                        {
                            !isEmpty && (
                                <span class="count">
                                    {publishedProjects.length} projet
                                    {publishedProjects.length > 1 ? "s" : ""}
                                </span>
                            )
                        }
                    </div>

                    <h1 class="page-title">Projets</h1>
                    <p class="subtitle">
                        Présentation de mes réalisations techniques et
                        expérimentations.
                    </p>
                </header>

                {
                    isEmpty && (
                        <div class="empty-state" role="status">
                            <svg
                                class="empty-icon"
                                width="36"
                                height="36"
                                viewBox="0 0 36 36"
                                fill="none"
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <rect
                                    x="1"
                                    y="1"
                                    width="34"
                                    height="34"
                                    rx="4"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-dasharray="4 3"
                                />
                                <path
                                    d="M12 18h12M18 12v12"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                />
                            </svg>
                            <p class="empty-title">
                                Aucun projet pour le moment
                            </p>
                            <p class="empty-text">
                                Les projets arrivent bientôt. Revenez dans
                                quelques temps.
                            </p>
                        </div>
                    )
                }

                {
                    page.currentPage === 1 && featured.length > 0 && (
                        <section
                            class="grid-section animate-fade-in"
                            aria-labelledby="featured-heading"
                        >
                            <div class="section-strip">
                                <h2 id="featured-heading" class="section-label">
                                    Sélection
                                </h2>
                                <span class="section-line" aria-hidden="true" />
                            </div>
                            <div class="projects-grid featured-grid">
                                {featured.map((p, i) => (
                                    <ProjectCard
                                        project={p}
                                        index={i}
                                        headingLevel="h3"
                                    />
                                ))}
                            </div>
                        </section>
                    )
                }

                {
                    others.length > 0 && (
                        <section
                            class="grid-section animate-fade-in"
                            aria-labelledby="archive-heading"
                        >
                            <div class="section-strip">
                                <h2 id="archive-heading" class="section-label">
                                    Archive
                                </h2>
                                <span class="section-line" aria-hidden="true" />
                            </div>
                            <div class="projects-grid">
                                {others.map((p, i) => (
                                    <ProjectCard
                                        project={p}
                                        index={i + featured.length}
                                        headingLevel="h3"
                                    />
                                ))}
                            </div>
                        </section>
                    )
                }

                {
                    page.lastPage > 1 && (
                        <nav class="pagination" aria-label="Pagination">
                            {page.url.prev ? (
                                <a href={page.url.prev} class="page-link prev">
                                    Précédent
                                </a>
                            ) : (
                                <span class="page-link disabled">
                                    Précédent
                                </span>
                            )}

                            <span class="page-status">
                                Page {page.currentPage} / {page.lastPage}
                            </span>

                            {page.url.next ? (
                                <a href={page.url.next} class="page-link next">
                                    Suivant
                                </a>
                            ) : (
                                <span class="page-link disabled">Suivant</span>
                            )}
                        </nav>
                    )
                }
            </div>
        </main>

        <Footer />
    </body>
</html>

<style>
    .project-index {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: clamp(2.5rem, 6vw, 4.5rem);
    }

    .project-index :is(h1, h2, h3, h4, h5, h6) {
        animation: none !important;
    }

    .project-index ul,
    .project-index ol {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .project-index li::before,
    .project-index li::after {
        content: none !important;
        display: none;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .header-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .header-eyebrow .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-accent);
        flex-shrink: 0;
    }

    .header-eyebrow .label {
        font-family: var(--font-title);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    .header-eyebrow .count {
        margin-left: auto;
        font-family: var(--font-code);
        font-size: 0.75rem;
        color: var(--color-muted);
        letter-spacing: 0.02em;
    }

    .page-title {
        font-family: var(--font-title);
        font-size: clamp(2.5rem, 8vw, 4rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.04em;
        color: var(--color-text);
        margin: 0;
        text-wrap: balance;
    }

    .subtitle {
        font-size: clamp(0.95rem, 2vw, 1.1rem);
        color: var(--color-muted);
        margin: 0;
        max-width: 48ch;
        line-height: 1.7;
        text-wrap: pretty;
    }

    .grid-section {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .section-strip {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .section-label {
        font-family: var(--font-title);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
        white-space: nowrap;
        margin: 0;
        padding: 0;
    }

    .section-line {
        flex: 1;
        height: 1px;
        background: var(--color-border);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    @media (min-width: 1024px) {
        .featured-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: clamp(3rem, 8vw, 5rem) 2rem;
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-lg);
        text-align: center;
        color: var(--color-muted);
    }

    .empty-icon {
        opacity: 0.3;
    }

    .empty-title {
        font-family: var(--font-title);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-text);
        margin: 0;
        letter-spacing: -0.01em;
    }

    .empty-text {
        font-size: 0.95rem;
        color: var(--color-muted);
        margin: 0;
        max-width: 36ch;
        line-height: 1.6;
    }

    .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
    }

    .page-link {
        font-family: var(--font-title);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        color: var(--color-accent);
        padding: 0.5rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        transition:
            border-color var(--duration-base) var(--ease-spring),
            transform var(--duration-base) var(--ease-spring);
    }

    .page-link.disabled {
        color: var(--color-muted);
        opacity: 0.5;
        pointer-events: none;
    }

    @media (hover: hover) {
        .page-link:not(.disabled):hover {
            border-color: rgba(var(--accent), 0.4);
            transform: translateY(-1px);
        }
    }

    .page-status {
        font-size: 0.85rem;
        color: var(--color-muted);
    }

    @media (max-width: 768px) {
        .projects-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-fade-in {
            animation: none !important;
        }
    }
</style>
