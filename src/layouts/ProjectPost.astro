---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import Header from "../components/Header.astro";
import "../styles/article.css";
import fallBackImage from "../assets/pexels-pixabay-270488.webp";

interface ProjectNavTarget {
    title: string;
    slug: string;
}

type Props = CollectionEntry<"projects">["data"] & {
    technologies?: string[];
    liveUrl?: string;
    sourceUrl?: string;
    prev?: ProjectNavTarget;
    next?: ProjectNavTarget;
};

const {
    title,
    description,
    categoryTag,
    pubDate,
    updatedDate,
    heroImage,
    heroImageDescription,
    technologies = [],
    liveUrl,
    sourceUrl,
    prev,
    next,
} = Astro.props;

const imageSrc = heroImage ?? fallBackImage;
---

<html lang="fr">
    <head>
        <BaseHead
            title={title}
            description={description}
            image={heroImage}
            ImageDescription={heroImageDescription}
        />
    </head>

    <body>
        <Header />
        <div class="reading-progress" aria-hidden="true"><span data-progress></span></div>

        <main>
            <div class="project-post-layout">
                <a href="/project" class="back-link">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M12.5 8H3.5M3.5 8L7.5 4M3.5 8L7.5 12" />
                    </svg>
                    Tous les projets
                </a>

                <article class="project-cover animate-fade-in">
                    <div class="cover-meta">
                        <div class="cover-eyebrow">
                            <span class="label">{categoryTag}</span>
                            <span class="date">
                                <FormattedDate date={pubDate} />
                                {
                                    updatedDate && (
                                        <>
                                            {" "}
                                            ·{" "}
                                            <FormattedDate date={updatedDate} />
                                        </>
                                    )
                                }
                            </span>
                        </div>

                        <h1>{title}</h1>
                        <p class="cover-description">{description}</p>

                        <div class="cover-footer">
                            {
                                technologies.length > 0 && (
                                    <ul class="tech-list">
                                        {technologies.map((tech) => (
                                            <li class="tech-item">
                                                {tech}
                                            </li>
                                        ))}
                                    </ul>
                                )
                            }

                            {
                                (liveUrl || sourceUrl) && (
                                    <div class="external-links">
                                        {liveUrl && (
                                            <a
                                                href={liveUrl}
                                                class="btn link-btn"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                Live Demo
                                                <svg
                                                    width="11"
                                                    height="11"
                                                    viewBox="0 0 12 12"
                                                    fill="none"
                                                    aria-hidden="true"
                                                >
                                                    <path
                                                        d="M1 11L11 1M11 1H1M11 1V11"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    />
                                                </svg>
                                            </a>
                                        )}
                                        {sourceUrl && (
                                            <a
                                                href={sourceUrl}
                                                class="btn link-btn secondary"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                Code source
                                                <GitHubIcon size={13} />
                                            </a>
                                        )}
                                    </div>
                                )
                            }
                        </div>
                    </div>

                    <div class="cover-image">
                        <Image
                            src={imageSrc}
                            alt={heroImageDescription ?? ""}
                            loading="eager"
                            fetchpriority="high"
                            widths={[300, 600, 900]}
                            sizes="(max-width: 768px) 100vw, 300px"
                            quality={70}
                            format="webp"
                        />
                    </div>
                </article>

                <div class="article-body animate-fade-in">
                    <div class="prose">
                        <slot />
                    </div>
                </div>

                {
                    (prev || next) && (
                        <nav
                            class="project-nav"
                            aria-label="Navigation entre projets"
                        >
                            {prev ? (
                                <a
                                    href={`/project/${prev.slug}/`}
                                    class="project-nav-link"
                                >
                                    <span class="project-nav-label">
                                        Projet précédent
                                    </span>
                                    <span class="project-nav-title">
                                        {prev.title}
                                    </span>
                                </a>
                            ) : (
                                <span
                                    class="project-nav-empty"
                                    aria-hidden="true"
                                />
                            )}
                            {next ? (
                                <a
                                    href={`/project/${next.slug}/`}
                                    class="project-nav-link project-nav-next"
                                >
                                    <span class="project-nav-label">
                                        Projet suivant
                                    </span>
                                    <span class="project-nav-title">
                                        {next.title}
                                    </span>
                                </a>
                            ) : (
                                <span
                                    class="project-nav-empty"
                                    aria-hidden="true"
                                />
                            )}
                        </nav>
                    )
                }
            </div>
        </main>

        <Footer />
        <button class="to-top" data-to-top aria-label="Retour en haut" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="19" x2="12" y2="5"></line>
                <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
        </button>
        <script>
            import { initReading } from "../scripts/reading.ts";
            initReading();
        </script>
    </body>
</html>

<style is:global>
    .project-post-layout {
        width: 100%;
        max-width: 900px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        gap: 0.45rem;
        font-family: var(--font-title);
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-muted);
        text-decoration: none;
        transition:
            color var(--duration-fast) ease,
            gap var(--duration-fast) ease;
    }

    .back-link:hover {
        color: var(--color-text);
        gap: 0.65rem;
    }

    .project-cover {
        display: grid;
        grid-template-columns: 1fr 300px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-strong);
    }

    .cover-meta {
        padding: 2.25rem;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .cover-eyebrow {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        margin-bottom: 1.75rem;
        min-width: 0;
    }

    .cover-eyebrow .label {
        font-family: var(--font-title);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        color: var(--color-accent);
        text-transform: uppercase;
        white-space: nowrap;
    }

    .cover-eyebrow .date {
        font-family: var(--font-code);
        font-size: 0.75rem;
        color: var(--color-muted);
        margin-left: auto;
        letter-spacing: 0.02em;
        white-space: nowrap;
        padding-left: 0.5rem;
    }

    .project-post-layout h1 {
        font-family: var(--font-title);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.035em;
        color: var(--color-text);
        margin: 0 0 1.25rem;
        word-break: break-word;
        text-wrap: balance;
    }

    .cover-description {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--color-muted);
        margin: 0 0 auto;
        padding-bottom: 2rem;
        max-width: 56ch;
        text-wrap: pretty;
    }

    .cover-footer {
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .cover-image {
        position: relative;
        overflow: hidden;
        background: var(--tint-05);
        min-height: 100%;
    }

    @media (min-width: 769px) {
        .cover-image::after {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            width: 28px;
            background: linear-gradient(to right, var(--color-surface), transparent);
            pointer-events: none;
        }
    }

    .cover-image img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: brightness(0.9) contrast(1.05) saturate(0.95);
        transition:
            filter var(--duration-base) ease,
            transform var(--duration-slow) var(--ease-spring);
    }

    :root[data-theme="light"] .cover-image img {
        filter: brightness(1) contrast(1) saturate(1);
    }

    @media (prefers-color-scheme: light) {
        :root:not([data-theme]) .cover-image img {
            filter: brightness(1) contrast(1) saturate(1);
        }
    }

    @media (hover: hover) {
        .project-cover:hover .cover-image img {
            filter: brightness(1) contrast(1.1) saturate(1.05);
            transform: scale(1.02);
        }
    }

    .tech-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tech-item {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.25rem 0.7rem;
        background: var(--tint-10);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition:
            border-color var(--duration-fast) ease,
            background var(--duration-fast) ease;
    }

    .tech-item:hover {
        border-color: rgba(var(--accent), 0.3);
        background: var(--tint-20);
    }

    .external-links {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .link-btn {
        gap: 0.45rem;
        font-size: 0.85rem;
        padding: 0.6rem 1.1rem;
        background: var(--color-accent);
        color: var(--color-bg);
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        transition:
            transform var(--duration-fast) var(--ease-spring),
            box-shadow var(--duration-fast) ease,
            background-color var(--duration-fast) ease,
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease;
    }

    .link-btn:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-soft);
    }

    .link-btn.secondary {
        background: transparent;
        border: 1px solid var(--color-border);
        color: var(--color-text);
    }

    .link-btn.secondary:hover {
        border-color: rgba(var(--accent), 0.3);
        background: var(--tint-05);
    }

    .article-body {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 2rem 2.5rem;
        box-shadow: var(--shadow-soft);
    }

    .article-body .prose {
        margin-inline: auto;
    }

    .project-nav {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .project-nav-link {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.25rem 1.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
        text-decoration: none;
        transition:
            border-color var(--duration-base) ease,
            box-shadow var(--duration-base) ease,
            transform var(--duration-base) var(--ease-spring);
    }

    @media (hover: hover) {
        .project-nav-link:hover {
            border-color: rgba(var(--accent), 0.2);
            box-shadow: var(--shadow-strong);
            transform: translateY(-2px);
        }
        .project-nav-link:hover .project-nav-title {
            color: var(--color-accent);
        }
    }

    .project-nav-next {
        text-align: right;
        align-items: flex-end;
    }

    .project-nav-label {
        font-family: var(--font-code);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-muted);
    }

    .project-nav-title {
        font-family: var(--font-title);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.35;
        color: var(--color-text);
        transition: color var(--duration-fast) ease;
    }

    .project-nav-empty {
        display: block;
    }

    @media (max-width: 768px) {
        .project-post-layout {
            gap: 2rem;
        }

        .project-cover {
            grid-template-columns: 1fr;
        }

        .cover-image {
            order: -1;
            aspect-ratio: 16 / 9;
            max-height: 260px;
            border-left: none;
            border-bottom: 1px solid var(--color-border);
            min-height: 0;
        }

        .cover-image img {
            position: static;
        }

        .cover-meta {
            padding: 2rem 1.75rem 1.75rem;
        }

        .article-body {
            padding: 1.75rem 1.5rem;
        }
    }

    @media (max-width: 640px) {
        .project-nav {
            grid-template-columns: 1fr;
        }

        .project-nav-next {
            text-align: left;
            align-items: flex-start;
        }

        .project-nav-empty {
            display: none;
        }
    }

    @media (max-width: 480px) {
        .cover-meta {
            padding: 1.75rem 1.25rem 1.5rem;
        }

        .cover-eyebrow {
            margin-bottom: 1.5rem;
        }

        .cover-description {
            font-size: 0.95rem;
            padding-bottom: 1.75rem;
        }

        .cover-footer {
            padding-top: 1.25rem;
        }

        .article-body {
            padding: 1.5rem 1.25rem;
        }

        .project-nav-link {
            padding: 1.1rem 1.25rem;
        }

        .external-links {
            gap: 0.6rem;
        }

        .link-btn {
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
            flex: 1;
            justify-content: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .link-btn:hover {
            transform: none;
        }
        .project-nav-link:hover {
            transform: none;
        }
        .back-link:hover {
            gap: 0.45rem;
        }
    }
</style>
