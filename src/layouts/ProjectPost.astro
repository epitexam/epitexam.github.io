---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import Header from "../components/Header.astro";
import "../styles/article.css";
import fallBackImage from "../assets/pexels-pixabay-270488.webp";

type Props = CollectionEntry<"projects">["data"] & {
    technologies?: string[];
    liveUrl?: string;
    sourceUrl?: string;
};

const {
    title,
    description,
    categoryTag,
    pubDate,
    updatedDate,
    heroImage,
    heroImageDescription,
    technologies = [],
    liveUrl,
    sourceUrl,
} = Astro.props;

const imageSrc = heroImage ?? fallBackImage;
---

<html lang="fr">
    <head>
        <BaseHead
            title={title}
            description={description}
            image={heroImage}
            ImageDescription={heroImageDescription}
        />
    </head>

    <body>
        <Header />

        <main>
            <div class="project-post-layout">
                <article class="project-cover animate-fade-in">
                    <div class="cover-meta">
                        <div class="cover-eyebrow">
                            <span class="label">{categoryTag}</span>
                            <span class="date">
                                <FormattedDate date={pubDate} />
                                {
                                    updatedDate && (
                                        <>
                                            {" "}
                                            ·{" "}
                                            <FormattedDate date={updatedDate} />
                                        </>
                                    )
                                }
                            </span>
                        </div>

                        <h1>{title}</h1>
                        <p class="cover-description">{description}</p>

                        <div class="cover-footer">
                            {
                                technologies.length > 0 && (
                                    <ul class="tech-list">
                                        {technologies.map((tech) => (
                                            <li class="tech-item">
                                                {tech}
                                            </li>
                                        ))}
                                    </ul>
                                )
                            }

                            {
                                (liveUrl || sourceUrl) && (
                                    <div class="external-links">
                                        {liveUrl && (
                                            <a
                                                href={liveUrl}
                                                class="btn link-btn"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                Live Demo
                                                <svg
                                                    width="11"
                                                    height="11"
                                                    viewBox="0 0 12 12"
                                                    fill="none"
                                                    aria-hidden="true"
                                                >
                                                    <path
                                                        d="M1 11L11 1M11 1H1M11 1V11"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    />
                                                </svg>
                                            </a>
                                        )}
                                        {sourceUrl && (
                                            <a
                                                href={sourceUrl}
                                                class="btn link-btn secondary"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                Code source
                                                <GitHubIcon size={13} />
                                            </a>
                                        )}
                                    </div>
                                )
                            }
                        </div>
                    </div>

                    <div class="cover-image">
                        <Image
                            src={imageSrc}
                            alt={heroImageDescription ?? ""}
                            loading="eager"
                            fetchpriority="high"
                            widths={[340, 680, 1024]}
                            sizes="(max-width: 768px) 100vw, 340px"
                            quality={70}
                            format="webp"
                        />
                    </div>
                </article>

                <div class="article-body animate-fade-in">
                    <div class="prose">
                        <slot />
                    </div>
                </div>
            </div>
        </main>

        <Footer />
    </body>
</html>

<style is:global>
    .project-post-layout {
        width: 100%;
        max-width: 900px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .project-cover {
        display: grid;
        grid-template-columns: 1fr 340px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-strong);
    }

    .cover-meta {
        padding: 2.5rem 2.5rem 2rem;
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--color-border);
        min-width: 0;
    }

    .cover-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        min-width: 0;
    }

    .cover-eyebrow::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-accent);
        flex-shrink: 0;
    }

    .cover-eyebrow .label {
        font-family: var(--font-title);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        color: var(--color-accent);
        text-transform: uppercase;
        white-space: nowrap;
    }

    .cover-eyebrow .date {
        font-family: var(--font-code);
        font-size: 0.75rem;
        color: var(--color-muted);
        margin-left: auto;
        letter-spacing: 0.02em;
        white-space: nowrap;
        padding-left: 0.5rem;
    }

    .project-post-layout h1 {
        font-family: var(--font-title);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: var(--color-text);
        margin: 0 0 1rem;
        word-break: break-word;
        text-wrap: balance;
    }

    .cover-description {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--color-muted);
        margin: 0 0 auto;
        padding-bottom: 1.75rem;
        text-wrap: pretty;
    }

    .cover-footer {
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .tech-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tech-item {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.25rem 0.7rem;
        background: var(--tint-10);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition:
            border-color var(--duration-fast) ease,
            background var(--duration-fast) ease;
    }

    .tech-item:hover {
        border-color: rgba(var(--accent), 0.3);
        background: var(--tint-20);
    }

    .external-links {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .link-btn {
        gap: 0.45rem;
        font-size: 0.85rem;
        padding: 0.6rem 1.1rem;
        background: var(--color-accent);
        color: var(--color-bg);
        border: 1px solid transparent;
        border-radius: 999px;
        transition:
            transform var(--duration-fast) var(--ease-spring),
            box-shadow var(--duration-fast) ease,
            background-color var(--duration-fast) ease,
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease;
    }

    .link-btn:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-soft);
    }

    .link-btn.secondary {
        background: transparent;
        border: 1px solid var(--color-border);
        color: var(--color-text);
    }

    .link-btn.secondary:hover {
        border-color: rgba(var(--accent), 0.3);
        background: var(--tint-05);
    }

    .cover-image {
        position: relative;
        overflow: hidden;
        background: var(--color-bg);
    }

    .cover-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;

        filter: brightness(0.9) contrast(1.05) saturate(0.95);
        transition:
            filter var(--duration-base) ease,
            transform var(--duration-slow) var(--ease-spring);
    }

    .project-cover:hover .cover-image img {
        filter: brightness(1) contrast(1.1) saturate(1.05);
        transform: scale(1.02);
    }

    .article-body {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 2.5rem;
        box-shadow: var(--shadow-soft);
    }

    @media (max-width: 768px) {
        .project-post-layout {
            gap: 2rem;
        }

        .project-cover {
            grid-template-columns: 1fr;
            grid-template-rows: 240px auto;
        }

        .cover-image {
            order: -1;
            border-right: none;
            border-bottom: 1px solid var(--color-border);
        }

        .cover-meta {
            border-right: none;
            padding: 2rem 1.75rem 1.5rem;
        }

        .article-body {
            padding: 2rem 1.75rem;
        }
    }

    @media (max-width: 480px) {
        .cover-meta {
            padding: 1.5rem 1.25rem 1.25rem;
        }

        .cover-eyebrow {
            margin-bottom: 1.25rem;
        }

        .cover-description {
            font-size: 0.95rem;
            padding-bottom: 1.5rem;
        }

        .cover-footer {
            padding-top: 1.25rem;
            gap: 1rem;
        }

        .article-body {
            padding: 1.75rem 1.25rem;
        }

        .external-links {
            gap: 0.6rem;
        }

        .link-btn {
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
            flex: 1;
            justify-content: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-cover:hover .cover-image img {
            transform: none;
        }
        .link-btn:hover {
            transform: none;
        }
    }
</style>
