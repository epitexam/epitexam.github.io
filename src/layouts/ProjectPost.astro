---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import Header from "../components/Header.astro";
import "../styles/article.css";

interface ProjectNavTarget {
    title: string;
    slug: string;
}

type Props = CollectionEntry<"projects">["data"] & {
    technologies?: string[];
    liveUrl?: string;
    sourceUrl?: string;
    prev?: ProjectNavTarget;
    next?: ProjectNavTarget;
};

const {
    title,
    description,
    categoryTag,
    pubDate,
    updatedDate,
    heroImage,
    heroImageDescription,
    technologies = [],
    liveUrl,
    sourceUrl,
    prev,
    next,
} = Astro.props;
---

<html lang="fr">
    <head>
        <BaseHead
            title={title}
            description={description}
            image={heroImage}
            ImageDescription={heroImageDescription}
        />
    </head>

    <body>
        <Header />
        <div class="reading-progress" aria-hidden="true"><span data-progress></span></div>

        <main>
            <div class="project-post-layout">
                <a href="/project" class="back-link">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M12.5 8H3.5M3.5 8L7.5 4M3.5 8L7.5 12" />
                    </svg>
                    Tous les projets
                </a>

                <header class="project-header animate-fade-in">
                    <div class="project-eyebrow">
                        <span class="label">{categoryTag}</span>
                        <span class="date">
                            <FormattedDate date={pubDate} />
                            {
                                updatedDate && (
                                    <>
                                        {" "}
                                        ·{" "}
                                        <FormattedDate date={updatedDate} />
                                    </>
                                )
                            }
                        </span>
                    </div>

                    <h1>{title}</h1>
                    <p class="project-description">{description}</p>

                    <div class="project-meta">
                        {
                            technologies.length > 0 && (
                                <ul class="tech-list">
                                    {technologies.map((tech) => (
                                        <li class="tech-item">
                                            {tech}
                                        </li>
                                    ))}
                                </ul>
                            )
                        }

                        {
                            (liveUrl || sourceUrl) && (
                                <div class="external-links">
                                    {liveUrl && (
                                        <a
                                            href={liveUrl}
                                            class="btn link-btn"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Live Demo
                                            <svg
                                                width="11"
                                                height="11"
                                                viewBox="0 0 12 12"
                                                fill="none"
                                                aria-hidden="true"
                                            >
                                                <path
                                                    d="M1 11L11 1M11 1H1M11 1V11"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                />
                                            </svg>
                                        </a>
                                    )}
                                    {sourceUrl && (
                                        <a
                                            href={sourceUrl}
                                            class="btn link-btn secondary"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Code source
                                            <GitHubIcon size={13} />
                                        </a>
                                    )}
                                </div>
                            )
                        }
                    </div>
                </header>

                <div class="article-body animate-fade-in">
                    <div class="prose">
                        <slot />
                    </div>
                </div>

                {
                    (prev || next) && (
                        <nav
                            class="project-nav"
                            aria-label="Navigation entre projets"
                        >
                            {prev ? (
                                <a
                                    href={`/project/${prev.slug}/`}
                                    class="project-nav-link"
                                >
                                    <span class="project-nav-label">
                                        Projet précédent
                                    </span>
                                    <span class="project-nav-title">
                                        {prev.title}
                                    </span>
                                </a>
                            ) : (
                                <span
                                    class="project-nav-empty"
                                    aria-hidden="true"
                                />
                            )}
                            {next ? (
                                <a
                                    href={`/project/${next.slug}/`}
                                    class="project-nav-link project-nav-next"
                                >
                                    <span class="project-nav-label">
                                        Projet suivant
                                    </span>
                                    <span class="project-nav-title">
                                        {next.title}
                                    </span>
                                </a>
                            ) : (
                                <span
                                    class="project-nav-empty"
                                    aria-hidden="true"
                                />
                            )}
                        </nav>
                    )
                }
            </div>
        </main>

        <Footer />
        <button class="to-top" data-to-top aria-label="Retour en haut" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="19" x2="12" y2="5"></line>
                <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
        </button>
        <script>
            import { initReading } from "../scripts/reading.ts";
            initReading();
        </script>
    </body>
</html>

<style is:global>
    .project-post-layout {
        width: 100%;
        max-width: 900px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        gap: 0.45rem;
        font-family: var(--font-title);
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-muted);
        text-decoration: none;
        transition:
            color var(--duration-fast) ease,
            gap var(--duration-fast) ease;
    }

    .back-link:hover {
        color: var(--color-text);
        gap: 0.65rem;
    }

    .project-header {
        display: flex;
        flex-direction: column;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--color-border);
    }

    .project-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        min-width: 0;
    }

    .project-eyebrow::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-accent);
        flex-shrink: 0;
    }

    .project-eyebrow .label {
        font-family: var(--font-title);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        color: var(--color-accent);
        text-transform: uppercase;
        white-space: nowrap;
    }

    .project-eyebrow .date {
        font-family: var(--font-code);
        font-size: 0.75rem;
        color: var(--color-muted);
        margin-left: auto;
        letter-spacing: 0.02em;
        white-space: nowrap;
        padding-left: 0.5rem;
    }

    .project-post-layout h1 {
        font-family: var(--font-title);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: var(--color-text);
        margin: 0 0 1rem;
        word-break: break-word;
        text-wrap: balance;
    }

    .project-description {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--color-muted);
        margin: 0;
        max-width: 62ch;
        text-wrap: pretty;
    }

    .project-meta {
        margin-top: 1.75rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 1.5rem;
    }

    .tech-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tech-item {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.25rem 0.7rem;
        background: var(--tint-10);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition:
            border-color var(--duration-fast) ease,
            background var(--duration-fast) ease;
    }

    .tech-item:hover {
        border-color: rgba(var(--accent), 0.3);
        background: var(--tint-20);
    }

    .external-links {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .link-btn {
        gap: 0.45rem;
        font-size: 0.85rem;
        padding: 0.6rem 1.1rem;
        background: var(--color-accent);
        color: var(--color-bg);
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        transition:
            transform var(--duration-fast) var(--ease-spring),
            box-shadow var(--duration-fast) ease,
            background-color var(--duration-fast) ease,
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease;
    }

    .link-btn:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-soft);
    }

    .link-btn.secondary {
        background: transparent;
        border: 1px solid var(--color-border);
        color: var(--color-text);
    }

    .link-btn.secondary:hover {
        border-color: rgba(var(--accent), 0.3);
        background: var(--tint-05);
    }

    .article-body {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 2.5rem;
        box-shadow: var(--shadow-soft);
    }

    .project-nav {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .project-nav-link {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.25rem 1.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
        text-decoration: none;
        transition:
            border-color var(--duration-base) ease,
            box-shadow var(--duration-base) ease,
            transform var(--duration-base) var(--ease-spring);
    }

    @media (hover: hover) {
        .project-nav-link:hover {
            border-color: rgba(var(--accent), 0.2);
            box-shadow: var(--shadow-strong);
            transform: translateY(-2px);
        }
        .project-nav-link:hover .project-nav-title {
            color: var(--color-accent);
        }
    }

    .project-nav-next {
        text-align: right;
        align-items: flex-end;
    }

    .project-nav-label {
        font-family: var(--font-code);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-muted);
    }

    .project-nav-title {
        font-family: var(--font-title);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.35;
        color: var(--color-text);
        transition: color var(--duration-fast) ease;
    }

    .project-nav-empty {
        display: block;
    }

    @media (max-width: 768px) {
        .project-post-layout {
            gap: 2rem;
        }

        .project-header {
            padding-bottom: 1.75rem;
        }

        .article-body {
            padding: 2rem 1.75rem;
        }
    }

    @media (max-width: 640px) {
        .project-nav {
            grid-template-columns: 1fr;
        }

        .project-nav-next {
            text-align: left;
            align-items: flex-start;
        }

        .project-nav-empty {
            display: none;
        }
    }

    @media (max-width: 480px) {
        .project-header {
            padding-bottom: 1.5rem;
        }

        .project-eyebrow {
            margin-bottom: 1rem;
        }

        .project-description {
            font-size: 0.95rem;
        }

        .project-meta {
            margin-top: 1.5rem;
        }

        .article-body {
            padding: 1.75rem 1.25rem;
        }

        .project-nav-link {
            padding: 1.1rem 1.25rem;
        }

        .external-links {
            gap: 0.6rem;
        }

        .link-btn {
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
            flex: 1;
            justify-content: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .link-btn:hover {
            transform: none;
        }
        .project-nav-link:hover {
            transform: none;
        }
        .back-link:hover {
            gap: 0.45rem;
        }
    }
</style>
