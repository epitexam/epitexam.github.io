---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import mermaidUrl from "../styles/mermaid.css?url";
import "../styles/article.css";

type Props = CollectionEntry<"blog">["data"] & {
    hasMermaid?: boolean;
};

const {
    title,
    description,
    pubDate,
    updatedDate,
    heroImage,
    heroImageDescription,
    hasMermaid = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <BaseHead
            title={title}
            description={description}
            image={heroImage}
            ImageDescription={heroImageDescription}
        />
        {hasMermaid && <link rel="stylesheet" href={mermaidUrl} />}
    </head>

    <body>
        <Header />
        <div class="reading-progress" aria-hidden="true"><span data-progress></span></div>

        {
            heroImage && (
                <div class="hero-background">
                    <Image
                        src={heroImage}
                        alt={heroImageDescription ?? ""}
                        class="hero-img"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        widths={[768, 1024, 1440]}
                        sizes="100vw"
                    />
                </div>
            )
        }

        <main class="blog-post-layout">
            <article class="prose">
                <header class="title">
                    <p class="date">
                        <FormattedDate date={pubDate} />
                        {
                            updatedDate && (
                                <span class="last-updated-on">
                                    Mis à jour le{" "}
                                    <FormattedDate date={updatedDate} />
                                </span>
                            )
                        }
                    </p>
                    <h1>{title}</h1>
                </header>
                <slot />
            </article>
        </main>

        <Footer />
        <button class="to-top" data-to-top aria-label="Retour en haut" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="19" x2="12" y2="5"></line>
                <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
        </button>
        <script>
            (() => {
                const bar = document.querySelector<HTMLElement>("[data-progress]");
                const toTop = document.querySelector<HTMLElement>("[data-to-top]");
                const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                let queued = false;
                const update = () => {
                    queued = false;
                    const max = document.documentElement.scrollHeight - window.innerHeight;
                    const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
                    if (bar) bar.style.transform = `scaleX(${ratio})`;
                    if (toTop) toTop.classList.toggle("is-visible", window.scrollY > 600);
                };
                const onScroll = () => {
                    if (queued) return;
                    queued = true;
                    requestAnimationFrame(update);
                };
                update();
                window.addEventListener("scroll", onScroll, { passive: true });
                toTop?.addEventListener("click", () => {
                    window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
                });
                document.querySelectorAll("pre").forEach((pre) => {
                    if (pre.querySelector(".copy-btn")) return;
                    const code = pre.querySelector("code");
                    if (!code) return;
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "copy-btn";
                    btn.textContent = "Copier";
                    btn.setAttribute("aria-label", "Copier le bloc de code");
                    btn.addEventListener("click", async () => {
                        try {
                            await navigator.clipboard.writeText(code.innerText);
                            btn.textContent = "Copié";
                            btn.setAttribute("data-copied", "true");
                        } catch {
                            btn.textContent = "Échec";
                        }
                        window.setTimeout(() => {
                            btn.textContent = "Copier";
                            btn.removeAttribute("data-copied");
                        }, 1600);
                    });
                    pre.appendChild(btn);
                });
            })();
        </script>
    </body>
</html>

<style>
    .blog-post-layout {
        padding-block-start: 0;
        margin-top: clamp(200px, 35vh, 420px);
        margin-bottom: 0;
        position: relative;
    }

    .hero-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 65vh;
        overflow: hidden;
        z-index: -1;
        pointer-events: none;
    }

    .hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        mask-image: linear-gradient(
            to bottom,
            black 0%,
            black 30%,
            transparent 100%
        );
        -webkit-mask-image: linear-gradient(
            to bottom,
            black 0%,
            black 30%,
            transparent 100%
        );
        filter: brightness(0.7);
        opacity: 0.8;

        transform: translateZ(0);
    }

    .prose {
        max-width: 970px;
        width: 100%;
        margin-inline: auto;
        padding-block: 1em;
        padding-inline: var(--content-padding);
        color: var(--color-text);
        line-height: 1.7;
        overflow-x: hidden;
    }

    .prose p {
        color: rgba(var(--text), 0.85);
    }

    .title {
        margin-bottom: 2em;
        padding: 1em 0;
        text-align: center;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    }

    .title h1 {
        margin: 0 0 0.5em 0;
        color: var(--color-text);
        font-size: clamp(2rem, 6vw, 3.5rem);
        line-height: 1.1;
    }

    .title .date {
        margin: 0 0 0.5em;
        color: var(--color-text);
        font-size: 1.1em;
        font-weight: 500;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    }

    .last-updated-on {
        display: block;
        font-style: italic;
        font-size: 0.8em;
        color: var(--color-muted);
    }

    .title::after {
        content: "";
        display: block;
        border: none;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            rgba(var(--accent), 0.5),
            transparent
        );
        margin: 2em auto;
        max-width: 150px;
    }

    /* ── Breakpoints ─────────────────────────────────────────── */
    @media (max-width: 768px) {
        .hero-background {
            height: 50vh;
        }

        .blog-post-layout {
            margin-top: clamp(150px, 25vh, 300px);
        }

        .title h1 {
            font-size: 2em;
        }

        .prose {
            padding-inline: var(--content-padding-mobile);
        }
    }

    /* ── Reduced motion ──────────────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .hero-background,
        .blog-post-layout {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
