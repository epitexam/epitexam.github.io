# Copiez ce fichier vers `.env` pour le développement local.
# La validation du typage est assurée par src/env.d.ts.

# URL WebSocket optionnelle pour le TerminalCard (/muffin).
# Vide ou absent = mode local uniquement, aucun appel réseau.
WS_API_URL=

# ID public Formspree pour le formulaire /contact (ex: PUBLIC_FORMSPREE_ID=xovgkrbn).
PUBLIC_FORMSPREE_ID=
